{
  "name": "my-win7-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "wine-helper": "node tools/wine-helper.js",
    "wine-bottle-setup": "WINDOWSSIM_SETUP_BOTTLE=true WINDOWSSIM_INSTALL_WINETRICKS=true node tools/wine-helper.js",
    "deploy": "vue-cli-service build && gh-pages -d dist"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "mammoth": "^1.8.0",
    "vue": "^2.6.14",
    "win7-ui": "^1.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "gh-pages": "^6.3.0",
    "vue-template-compiler": "^2.6.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
